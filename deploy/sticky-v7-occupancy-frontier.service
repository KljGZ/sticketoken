[Unit]
Description=StickyToken V7 prefix/suffix occupancy-frontier formal run
After=default.target
StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/mnt/data/jkl/StickyToken-v7-occupancy-frontier
Environment=V7_ROOT=/mnt/data/jkl/StickyToken-v7-occupancy-frontier
Environment=V7_PYTHON=/home/jkl/anaconda3/envs/StickyToken/bin/python
Environment=V7_CONFIG=configs/v7_mode3_occupancy_frontier.yaml
Environment=V7_OUTPUT=/mnt/data/jkl/StickyToken-v7-results/sticky_lab/sentence_t5_base/mode3_v7_occupancy_frontier_r3_priority
Environment=V7_PROFILE=formal
Environment=V7_GPUS=4,5,6,7
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/jkl/anaconda3/envs/StickyToken/bin:/home/jkl/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/mnt/data/jkl/StickyToken-v7-occupancy-frontier/scripts/run_v7_preflight.sh
ExecStart=/mnt/data/jkl/StickyToken-v7-occupancy-frontier/scripts/run_v7_remote.sh
Restart=on-failure
RestartSec=60
TimeoutStartSec=infinity
TimeoutStopSec=300
KillMode=control-group
Nice=0

[Install]
WantedBy=default.target
